{
  "name": "lupira-assistant-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start -w apps/mobile",
    "fetch:openapi": "npm run fetch:openapi -w apps/mobile",
    "gen:api": "npm run gen:api -w apps/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "overrides": {
    "react": "19.2.3"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.10"
  }
}
